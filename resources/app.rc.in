#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/metadata/icons/app.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Plants vs. Zombies Console Edition\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "pvz-console-edition\0"
      VALUE "OriginalFilename", "pvz-console-edition.exe\0"
      VALUE "ProductName", "pvz-console-edition\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
      VALUE "Comments", "Community Xbox 360 recompilation using ReXGlue\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
